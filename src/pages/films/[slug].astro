---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilmFrame from '../../components/FilmFrame.astro';
import BillingBlock from '../../components/BillingBlock.astro';
import { site, films } from '../../lib/content';

export function getStaticPaths() {
  return films.map((film, i) => ({
    params: { slug: film.slug },
    props: { film, i, prev: films[i - 1] ?? null, next: films[i + 1] ?? null },
  }));
}
const { film, i, prev, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={`${film.title} — ${site.person.name}`}
  description={film.synopsis}
  current="films"
  ogFilm={film.slug}
>
  <main id="main" tabindex="-1">
    <div class="wrap film-top">
      <a class="data link-quiet" href="/films/">All films</a>
      <p class="data" aria-label={`Film ${i + 1} of ${films.length}`}>{pad(i + 1)} / {pad(films.length)}</p>
    </div>

    <div class="wrap">
      <div class="film-stage" style={`--ar:${film.aspectRatio}`}>
        <FilmFrame film={film} variant="player" halo priority vt />
      </div>
    </div>

    <div class="wrap film-titlebar">
      <h1 class="display film-h1">{film.title}</h1>
      <p class="data film-facts"><span>{film.year}</span> <span>{film.runtime}</span></p>
    </div>

    <div class="wrap film-body">
      <p class="lead film-synopsis">{film.synopsis}</p>
      <div class="film-side">
        <BillingBlock film={film} />
        <p class="film-watch">
          <a class="data link-quiet" href={film.youtubeUrl} target="_blank" rel="noopener">Watch on YouTube ↗</a>
        </p>
      </div>
    </div>

    <nav class="wrap film-pager" aria-label="More films">
      {
        prev ? (
          <a class="pager pager--prev" href={`/films/${prev.slug}/`} rel="prev">
            <span class="data">Previous</span>
            <span class="pager__title">{prev.title}</span>
          </a>
        ) : (
          <span></span>
        )
      }
      {
        next && (
          <a class="pager pager--next" href={`/films/${next.slug}/`} rel="next">
            <span class="data">Next</span>
            <span class="pager__title">{next.title}</span>
          </a>
        )
      }
    </nav>
  </main>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilmFrame from '../../components/FilmFrame.astro';
import FilmList from '../../components/FilmList.astro';
import StillsGallery from '../../components/StillsGallery.astro';
import { filmBySlug, stillBySlug, personJsonLd, nativeWidth } from '../../lib/content';
import { content, href, langPaths, localeOf, t } from '../../i18n';

export const getStaticPaths = langPaths;
const locale = localeOf(Astro.currentLocale);
const site = content(locale);
const ui = t(locale);

const film = filmBySlug(site.home.featuredFilmSlug, locale);
const [featuredPrefix] = site.home.featuredLabel.split(' / '); // "Featured work"
const strip = ['days-of-heaven', 'untitled-03', 'plein-soleil'].map((s) => stillBySlug(s, locale));
const intro = site.about.paragraphs[0];
---

<BaseLayout
  title={`${site.person.name} — ${site.person.role}`}
  description={intro}
  jsonLd={personJsonLd(locale, Astro.site?.href)}
  intro
>
  <main id="main" tabindex="-1">
    <section class="wrap hero">
      <div class="film-stage film-stage--hero" style={`--ar:${film.aspectRatio};--native:${nativeWidth(film.aspectRatio)}px`}>
        <FilmFrame film={film} variant="player" halo priority class="hero-frame" />
        <div class="hero-meta">
          <div class="hero-credit">
            <h1 class="hero-name">{site.person.name}</h1>
            <p class="data">{site.person.role}</p>
            <p class="data">{site.person.homeKickerRight}</p>
          </div>
          <div class="hero-work">
            <h2 class="hero-title"><a href={href(locale, `/films/${film.slug}/`)}>{film.title}</a></h2>
            <p class="data">{featuredPrefix}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="wrap intro-block">
      <p class="lead">{intro}</p>
      <a class="pill" href={href(locale, '/about/')}>{site.about.heading}</a>
    </section>

    <section class="wrap block">
      <div class="section-head"><h2>{ui.films}</h2></div>
      <FilmList />
    </section>

    <section class="wrap block">
      <div class="section-head">
        <h2>{ui.stills}</h2>
        <a class="pill" href={href(locale, '/stills/')}>{ui.allStills}</a>
      </div>
      <StillsGallery items={strip} strip />
    </section>
  </main>
</BaseLayout>

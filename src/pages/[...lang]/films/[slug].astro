---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilmFrame from '../../../components/FilmFrame.astro';
import BillingBlock from '../../../components/BillingBlock.astro';
import { nativeWidth } from '../../../lib/content';
import { content, href, langPaths, localeOf, t } from '../../../i18n';

export function getStaticPaths() {
  return langPaths().flatMap(({ params: { lang } }) => {
    const films = content(localeOf(lang)).films;
    return films.map((film, i) => ({
      params: { lang, slug: film.slug },
      props: { film, i, total: films.length, prev: films[i - 1] ?? null, next: films[i + 1] ?? null },
    }));
  });
}
const locale = localeOf(Astro.currentLocale);
const site = content(locale);
const ui = t(locale);
const { film, i, total, prev, next } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title={`${film.title} — ${site.person.name}`}
  description={film.synopsis}
  current="films"
  ogFilm={film.slug}
>
  <main id="main" tabindex="-1" class="film-page">
    <div class="wrap film-top">
      <a class="data link-quiet" href={href(locale, '/films/')}>{ui.allFilms}</a>
      <p class="data" aria-label={ui.filmOf(i + 1, total)}>{pad(i + 1)} / {pad(total)}</p>
    </div>

    <div class="wrap">
      <div class="film-stage" style={`--ar:${film.aspectRatio};--native:${nativeWidth(film.aspectRatio)}px`}>
        <FilmFrame film={film} variant="player" halo priority screen />
      </div>
    </div>

    <div class="wrap film-card">
      <h1 class="title">{film.title}</h1>
      <p class="data film-facts"><span>{film.year}</span> <span>{film.runtime}</span></p>
    </div>

    <div class="wrap film-body">
      <p class="lead film-synopsis">{film.synopsis}</p>
      <BillingBlock film={film} />
      <p class="film-watch">
        <a class="data link-quiet" href={film.youtubeUrl} target="_blank" rel="noopener">{ui.watchOnYoutube} ↗</a>
      </p>
    </div>

    <nav class="wrap film-pager" aria-label={ui.moreFilms}>
      {
        prev ? (
          <a class="pager pager--prev" href={href(locale, `/films/${prev.slug}/`)} rel="prev">
            <span class="pager__thumb" aria-hidden="true" style={`--ar:${prev.aspectRatio}`}>
              <FilmFrame film={prev} small />
            </span>
            <span class="pager__text">
              <span class="data">{ui.prev}</span>
              <span class="pager__title">{prev.title}</span>
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a class="pager pager--next" href={href(locale, `/films/${next.slug}/`)} rel="next">
            <span class="pager__text">
              <span class="data">{ui.next}</span>
              <span class="pager__title">{next.title}</span>
            </span>
            <span class="pager__thumb" aria-hidden="true" style={`--ar:${next.aspectRatio}`}>
              <FilmFrame film={next} small />
            </span>
          </a>
        )
      }
    </nav>
  </main>
</BaseLayout>

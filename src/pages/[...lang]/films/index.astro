---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FilmList from '../../../components/FilmList.astro';
import { content, langPaths, localeOf, t } from '../../../i18n';

export const getStaticPaths = langPaths;
const locale = localeOf(Astro.currentLocale);
const site = content(locale);
const ui = t(locale);
---

<BaseLayout
  title={`${ui.films} — ${site.person.name}`}
  description={site.about.paragraphs[0]}
  current="films"
>
  <main id="main" tabindex="-1">
    <div class="wrap page-head">
      <h1 class="title">{ui.films}</h1>
    </div>
    <div class="wrap">
      <FilmList />
    </div>
  </main>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { mailHref, telHref } from '../../lib/content';
import { content, langPaths, localeOf, t } from '../../i18n';

export const getStaticPaths = langPaths;
const locale = localeOf(Astro.currentLocale);
const site = content(locale);
const ui = t(locale);

const c = site.contact;
// Display form of a URL: host + path, no protocol.
const shown = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<BaseLayout
  title={`${c.heading} — ${site.person.name}`}
  description={site.about.paragraphs[0]}
  current="contact"
  footer={false}
>
  <main id="main" tabindex="-1">
    <div class="wrap page-head">
      <h1 class="title"><a class="display-link" href={mailHref}>{c.heading}</a></h1>
    </div>
    <div class="wrap">
      <dl class="rows">
        <div class="rows__row">
          <dt>{ui.email}</dt>
          <dd class="rows__email">
            <a href={mailHref}>{c.email}</a>
            <span class="copy" data-copy={c.email} data-copied={ui.copied} aria-live="polite">
              <button class="pill" type="button" data-copy-btn>{ui.copyEmail}</button>
            </span>
          </dd>
        </div>
        <div class="rows__row">
          <dt>{c.instagram.label}</dt>
          <dd><a href={c.instagram.url} target="_blank" rel="noopener">{shown(c.instagram.url)}</a></dd>
        </div>
        <div class="rows__row">
          <dt>{c.linkedin.label}</dt>
          <dd><a href={c.linkedin.url} target="_blank" rel="noopener">{shown(c.linkedin.url)}</a></dd>
        </div>
        <div class="rows__row">
          <dt>{ui.mobile}</dt>
          <dd><a href={telHref}>{c.mobile.label}</a></dd>
        </div>
        <div class="rows__row">
          <dt class="sr-only">{ui.location}</dt>
          <dd class="rows__where">{c.locationLines.map((l) => <span>{l}</span>)}</dd>
        </div>
      </dl>
    </div>
  </main>
</BaseLayout>

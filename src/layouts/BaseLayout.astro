---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import literataLatin from '@fontsource-variable/literata/files/literata-latin-opsz-normal.woff2?url';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site, posterUrl, filmBySlug } from '../lib/content';

export interface Props {
  title: string;
  description: string;
  /** Nav key of the current section ('films' | 'stills' | 'about' | 'contact'). */
  current?: string;
  /** Film whose poster is the Open Graph image (defaults to the featured film). */
  ogFilm?: string;
  jsonLd?: object;
  footer?: boolean;
  /** Home only: plays the one-time intro on a full page load. */
  intro?: boolean;
}
const { title, description, current, ogFilm, jsonLd, footer = true, intro = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const og = posterUrl(filmBySlug(ogFilm ?? site.home.featuredFilmSlug));
const introScript = `(function(){var w=window;if(location.pathname==='/'&&!w.__introSeen&&!matchMedia('(prefers-reduced-motion: reduce)').matches){document.documentElement.setAttribute('data-intro','');}w.__introSeen=true;})();`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <link rel="preload" as="font" type="font/woff2" href={literataLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatin} crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    {intro && <script is:inline set:html={introScript} />}
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <SiteNav current={current} />
    <slot />
    {footer && <SiteFooter />}
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

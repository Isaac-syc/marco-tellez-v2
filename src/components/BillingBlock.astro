---
import type { Film } from '../lib/content';
import { content, localeOf } from '../i18n';
const labelsOf = {
  en: ['Format', 'Aspect ratio', 'Color', 'Language'],
  es: ['Formato', 'Relación de aspecto', 'Color', 'Idioma'],
  cs: ['Formát', 'Poměr stran', 'Barva', 'Jazyk'],
};
const { film } = Astro.props as { film: Film };
const locale = localeOf(Astro.currentLocale);
const labels = labelsOf[locale];
const data = [
  [labels[0], film.format],
  [labels[1], film.aspectRatioLabel],
  [labels[2], film.color],
  [labels[3], film.language],
];
---

<dl class="billing">
  <div class="billing__credit">
    <dt>{film.credit}</dt>
    <dd>{content(locale).person.name}</dd>
  </div>
  <div class="billing__tech">
    {
      data.map(([k, v]) => (
        <div>
          <dt class="sr-only">{k}</dt>
          <dd>{v}</dd>
        </div>
      ))
    }
  </div>
</dl>
